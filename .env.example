# 複製成 .env 後填入真實值（.env 已列入 .gitignore，勿 commit）

# 啟用的 broker（逗號分隔），中信不走此處（用 --import-statement 匯入對帳單）
ENABLED_BROKERS=fugle,esun

# ── 元富/台新（taishin_sdk）───────────────────────────
FUGLE_IDENTITY=你的身分證字號
FUGLE_PASSWD=登入密碼
FUGLE_CERT_PATH=./certs/fugle.pfx
FUGLE_CERT_PASS=憑證密碼
FUGLE_ACCOUNT_NAME=元富

# ── 玉山證券（esun_trade SDK）──────────────────────────
ESUN_API_KEY=你的_API_KEY
ESUN_API_SECRET=你的_API_SECRET
ESUN_ACCOUNT=玉山帳號
ESUN_PASSWD=登入密碼
ESUN_CERT_PATH=./certs/esun.p12
ESUN_CERT_PASS=憑證密碼
ESUN_ACCOUNT_NAME=玉山
# 選填，預設為正式環境
# ESUN_API_ENTRY=https://esuntradingapi.esunsec.com.tw/api/v1

# ── 中信（月對帳單 PDF 匯入，無 API）─────────────────────
# 對帳單 PDF 開啟密碼為身分證字號
CTBC_STATEMENT_PASSWORD=你的身分證字號
CTBC_ACCOUNT_NAME=中信

# ── Google Sheets ───────────────────────────────────────
# 完整的 Service Account JSON 字串（需壓成單行）
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
GOOGLE_SHEET_ID=你的試算表_ID
GOOGLE_SHEET_NAME=對帳單
GOOGLE_STOCK_INFO_TAB=股票代號
